          "medianEventTimeMonths": 18
        }
      ],
      "model": {
        "type": "Kaplan-Meier",
        "covariates": 0,
        "proportionalHazardsEvidence": "not-applicable",
        "schoenfeldP": null,
        "timeVaryingEffects": false
      },
      "exposure": {
        "assignment": "baseline",
        "medianStartLagDays": 0,
        "modeling": "baseline-fixed"
      },
      "methods": {
        "competingRiskModel": false,
        "censoringTable": true,
        "landmarkAnalysis": false
