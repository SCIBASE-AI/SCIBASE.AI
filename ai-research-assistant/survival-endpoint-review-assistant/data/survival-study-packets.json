{
  "packetId": "survival-peer-review-demo-001",
  "title": "Synthetic Time-to-Event Manuscript Review Packet",
  "studies": [
    {
      "id": "os-immunotherapy-registry",
      "title": "Registry claim: immunotherapy extends overall survival",
      "design": "retrospective registry",
      "endpoint": {
        "primary": "overall survival",
        "definition": "Time from registry entry to death from any cause; censored at last verified contact.",
        "origin": "registry entry",
        "competingRisk": true
      },
      "arms": [
        {
          "name": "immunotherapy",
          "participants": 118,
          "events": 24,
          "censored": 38,
          "medianFollowUpMonths": 9,
          "medianEventTimeMonths": 13
        },
        {
          "name": "standard care",
          "participants": 122,
          "events": 42,
          "censored": 17,
          "medianFollowUpMonths": 14,
          "medianEventTimeMonths": 12
        }
      ],
      "model": {
        "type": "Cox proportional hazards",
        "covariates": 16,
        "proportionalHazardsEvidence": "schoenfeld",
        "schoenfeldP": 0.018,
        "timeVaryingEffects": false
      },
      "exposure": {
        "assignment": "post-baseline",
        "medianStartLagDays": 43,
        "modeling": "baseline-fixed"
      },
      "methods": {
        "competingRiskModel": false,
        "censoringTable": false,
        "landmarkAnalysis": false
      },
      "claims": [
        "Immunotherapy improves overall survival across the registry population.",
        "The effect is robust after multivariable adjustment."
      ]
    },
    {
      "id": "device-safety-prospective",
      "title": "Prospective device safety follow-up",
      "design": "single-arm prospective cohort",
      "endpoint": {
